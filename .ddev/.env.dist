TEST_BUNDLE_PATH=/home/to/Your/Project/opendxp.io/skeleton/lib
OPENDXP_CODECEPTION_FRAMEWORK_PATH=${TEST_BUNDLE_PATH}/opendxp-codeception-framework

# define current bundle names
TEST_BUNDLE_NAME=FormBuilderBundle
TEST_BUNDLE_DIR_NAME=formbuilder-bundle
TEST_BUNDLE_VENDOR_NAME=open-dxp/formbuilder-bundle

# define installer class. set to false if no installer is available
TEST_BUNDLE_INSTALLER_CLASS=OpenDxp\Bundle\FormBuilderBundle\Tool\Install

# run composer update on boot
TEST_EXECUTE_COMPOSER=true

# define dependencies versions
TEST_OPENDXP_VERSION=~1.0
TEST_SYMFONY_VERSION=^7.3