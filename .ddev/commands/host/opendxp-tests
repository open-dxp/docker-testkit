#!/usr/bin/env bash

## Description: Run OpenDXP Tests
## Usage: opendxp-tests-run
## Example: "ddev opendxp-tests-run codecept"
## ExecRaw: true

set -e

# One run at a time. Everything below rsyncs into app/ with --delete and rebuilds the database, so a
# second run entering here pulls the ground out from under the first. The lock is held for the whole
# command, so a caller waits instead of having to look whether anybody else is busy.
_OPENDXP_TESTS_LOCK="${TMPDIR:-/tmp}/opendxp-tests-$(id -u).lock"
exec 9>"$_OPENDXP_TESTS_LOCK"

if ! flock -n 9; then
    echo "A test run is already in progress. Waiting for it to finish..." >&2

    if ! flock -w 3600 9; then
        echo "Error: gave up after an hour. Something is holding $_OPENDXP_TESTS_LOCK" >&2
        exit 1
    fi
fi

RUN_COMPOSER=false
PREFER_LOWEST=false
ARGS=()

for arg in "$@"; do
    case "$arg" in
        --composer)
            RUN_COMPOSER=true
            ;;
        --lowest)
            PREFER_LOWEST=true
            ;;
        *)
            ARGS+=("$arg")
            ;;
    esac
done

. "$(dirname "$0")/../../scripts/sync-bundle.sh"

if ! ddev exec test -d "$_OPENDXP_CODECEPTION_FRAMEWORK_PATH"; then
    echo "Error: Codeception Framework source directory does not exist: $_OPENDXP_CODECEPTION_FRAMEWORK_PATH" >&2
    exit 1
fi

sync_bundle_into_app

ddev exec bash -c 'cd /var/www/html/app && chmod +x ./.github/ci/scripts/setup-opendxp-environment.sh'
ddev exec bash -c 'cd /var/www/html/app && ./.github/ci/scripts/setup-opendxp-environment.sh'

# copy htaccess (not required on github because we're using the symfony server there)
cp .ddev/apache/.htaccess app/public/.htaccess

# additional public statics
if [ -d "assets-test" ]; then
    ln -sfn ../../assets-test app/public/assets-test
fi

# The last analysis run, reachable at <project url>/analysis/ through the web server that is already
# there. The rsync above wipes app/, so the link is made again on every run.
mkdir -p app/var/analysis
ln -sfn ../var/analysis app/public/analysis

## geolite ip
if [ ! -f "GeoLite2-City.mmdb" ]; then
    wget -c https://raw.githubusercontent.com/wp-statistics/GeoLite2-City/master/GeoLite2-City.mmdb.gz -O GeoLite2-City.mmdb.gz
    gunzip GeoLite2-City.mmdb.gz
fi

mkdir -p app/var/config
cp GeoLite2-City.mmdb app/var/config/GeoLite2-City.mmdb

if [ "$RUN_COMPOSER" = true ]; then
    echo "run composer task..."
    COMPOSER_ARGS=()
    [ "$PREFER_LOWEST" = true ] && COMPOSER_ARGS+=(--lowest)
    ddev opendxp-tests-composer "${COMPOSER_ARGS[@]}"
fi

ddev opendxp-tests-dispatcher ${ARGS[@]}