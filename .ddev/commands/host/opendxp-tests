#!/usr/bin/env bash

## Description: Run OpenDXP tests for one bundle
## Usage: opendxp-tests-run <bundle> codecept|phpstan [args]
## Example: "ddev opendxp-tests-run formbuilder-bundle codecept tests/Acceptance/ExtJs/SaveFormCest.php"
## ExecRaw: true

set -e

. "$(dirname "$0")/../../scripts/testkit-lib.sh"

BUNDLE="$1"
shift || true

testkit_require_bundle "$BUNDLE" "opendxp-tests-run"

RUN_COMPOSER=false
PREFER_LOWEST=false
ARGS=()

for arg in "$@"; do
    case "$arg" in
        --composer) RUN_COMPOSER=true ;;
        --lowest)   PREFER_LOWEST=true ;;
        *)          ARGS+=("$arg") ;;
    esac
done

if testkit_slot_changed "$(awk -F'\t' -v b="$BUNDLE" '$2 == b { print $1; exit }' "$TESTKIT_SLOT_FILE" 2>/dev/null)" "$BUNDLE"; then
    FRESH=true
else
    FRESH=false
fi

SLOT=$(testkit_claim_slot "$BUNDLE")
PORT=$(testkit_port "$SLOT")
DATABASE=$(testkit_database "$SLOT")
APP="app/slot-$SLOT"

# One run per slot. The sync deletes and the tests rebuild the database, so two runs in the same
# slot would pull the ground out from under each other. Two bundles hold two slots and never meet.
_LOCK="${TMPDIR:-/tmp}/opendxp-tests-$(id -u)-slot-$SLOT.lock"
exec 9>"$_LOCK"

if ! flock -n 9; then
    echo "Slot $SLOT is busy. Waiting for it to finish..." >&2

    if ! flock -w 3600 9; then
        echo "Error: gave up after an hour. Something is holding $_LOCK" >&2
        exit 1
    fi
fi

echo "$BUNDLE -> slot $SLOT (port $PORT, $DATABASE)"

if [ "$FRESH" = true ]; then
    echo "slot $SLOT held a different bundle, installing from scratch"
    RUN_COMPOSER=true
fi

testkit_sync_bundle "$BUNDLE" "$SLOT" "$([ "$FRESH" = true ] && echo false || echo true)"
testkit_ensure_database "$DATABASE"

ddev exec bash -c "cd /var/www/html/$APP && export OPENDXP_PROJECT_ROOT=/var/www/html/$APP OPENDXP_CLASS_DIRECTORY=/var/www/html/$APP/var/classes OPENDXP_INSTALL_MYSQL_DATABASE=$DATABASE && chmod +x ./.github/ci/scripts/setup-opendxp-environment.sh && ./.github/ci/scripts/setup-opendxp-environment.sh"

# Written into the slot rather than exported: apache serves all ten slots from one process pool,
# so it can only learn which one it is answering for from the app it is answering from.
cat >> "$APP/.env" <<ENV
OPENDXP_PROJECT_ROOT=/var/www/html/$APP
OPENDXP_CLASS_DIRECTORY=/var/www/html/$APP/var/classes
OPENDXP_TEST_DB_DSN=mysql://db:db@db/$DATABASE
OPENDXP_INSTALL_MYSQL_DATABASE=$DATABASE
ENV

# Apache serves the slot, so it needs the rewrite rules github does not (the symfony server there
# resolves the front controller itself).
cp .ddev/apache/.htaccess "$APP/public/.htaccess"

if [ -d "assets-test" ]; then
    ln -sfn ../../../assets-test "$APP/public/assets-test"
fi

if [ ! -f "GeoLite2-City.mmdb" ]; then
    wget -q -c https://raw.githubusercontent.com/wp-statistics/GeoLite2-City/master/GeoLite2-City.mmdb.gz -O GeoLite2-City.mmdb.gz
    gunzip GeoLite2-City.mmdb.gz
fi

mkdir -p "$APP/var/config"
cp GeoLite2-City.mmdb "$APP/var/config/GeoLite2-City.mmdb"

if [ "$RUN_COMPOSER" = true ]; then
    COMPOSER_ARGS=()
    [ "$PREFER_LOWEST" = true ] && COMPOSER_ARGS+=(--lowest)
    ddev opendxp-tests-composer "$SLOT" "${COMPOSER_ARGS[@]}"
fi

ddev opendxp-tests-dispatcher "$SLOT" "$PORT" "$DATABASE" ${ARGS[@]}
