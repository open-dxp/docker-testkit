#!/usr/bin/env bash

## Description: Run the tests of one bundle inside the web container
## Usage: opendxp-tests-dispatcher <slot> <port> <database> codecept|phpstan [args]
## Example: "ddev opendxp-tests-dispatcher 7 31007 db_slot_7 codecept"
set -e

SLOT="$1"
PORT="$2"
DATABASE="$3"
PHP_VERSION="$4"
DATABASE_HOST="$5"
APP_REL="$6"
[ "$APP_REL" = "." ] && APP_REL=""
shift 6

PHP="/usr/bin/php$PHP_VERSION"

ROOT="/var/www/html/app/slot-$SLOT"
APP="$ROOT${APP_REL:+/$APP_REL}"
VENDOR="${APP_REL:+$APP_REL/}vendor"
APP_IP="$(ip addr show eth0 | grep 'inet\b' | awk '{print $2}' | cut -d/ -f1)"

# Before the testkit's own values, so those win on a name that appears in both.
if [ -s "$ROOT/.testkit-project-env" ]; then
    set -a
    . "$ROOT/.testkit-project-env"
    set +a
fi

export WEBDRIVER_HOST="selenium-chrome"
export WEBDRIVER_URL="http://$APP_IP:$PORT/"
export OPENDXP_PROJECT_ROOT="$APP"
export OPENDXP_CLASS_DIRECTORY="$APP/var/classes"
export OPENDXP_TEST_DB_DSN="mysql://db:db@$DATABASE_HOST/$DATABASE"
export OPENDXP_INSTALL_MYSQL_DATABASE="$DATABASE"

case "$1" in
    codecept)
        echo ""
        echo "*************************************************************************"
        echo "run codeception tests - slot $SLOT"
        echo "*************************************************************************"
        cd "$APP"
        # A capped limit, not -1: an unbounded run grows until the kernel needs memory and the
        # OOM killer takes the largest other process on the machine, which is the developer's IDE.
        "$PHP" -d memory_limit=3G vendor/bin/codecept run -c "$ROOT" --env local "${@:2}"
        ;;
    codecept-xdebug)
        echo ""
        echo "*************************************************************************"
        echo "run codeception tests with xdebug - slot $SLOT"
        echo "*************************************************************************"
        cd "$APP"
        PHP_IDE_CONFIG="serverName=opendxp.test" "$PHP" -dxdebug.remote_enable=1 -dxdebug.remote_autostart=On -dxdebug.idekey=PHPSTORM -dxdebug.remote_host=$2 -d memory_limit=3G vendor/bin/codecept run -c "$ROOT" --env local "${@:3}"
        ;;
    phpstan)
        echo ""
        echo "*************************************************************************"
        echo "run phpstan - slot $SLOT"
        echo "*************************************************************************"
        # phpstan.neon resolves its paths against the working directory.
        cd "$APP"
        NEON="phpstan.neon"
        [ -f "$NEON" ] || NEON="$ROOT/phpstan.neon"

        bin/console cache:warmup --env=test --no-optional-warmers
        mkdir -p "$ROOT/tests/_output"

        # phpstan caches its verdicts under sys_get_temp_dir(), which every slot in this container
        # shares. One slot's "class not found" would then be served to another.
        export TMPDIR="$APP/var/phpstan"
        mkdir -p "$TMPDIR"
        "$PHP" -d memory_limit=2G vendor/bin/phpstan analyse -c "$NEON" "${@:2}" || STATUS=$?
        # A second pass against a warm result cache costs almost nothing and gives the report JUnit.
        # Kept only when it is a report: phpstan writes nothing at all when it refuses to start, and
        # an empty file reads as a run that found nothing rather than one that never happened.
        JUNIT="$ROOT/tests/_output/phpstan.junit.xml"
        "$PHP" -d memory_limit=2G vendor/bin/phpstan analyse -c "$NEON" --no-progress \
            --error-format=junit "${@:2}" > "$JUNIT.part" 2>/dev/null || true

        if grep -q "<testsuite" "$JUNIT.part" 2>/dev/null; then
            mv "$JUNIT.part" "$JUNIT"
        else
            rm -f "$JUNIT.part"
        fi

        exit "${STATUS:-0}"
        ;;
    *)
        echo "Usage: ddev opendxp-tests-run <path or bundle> codecept|codecept-xdebug|phpstan [args]" >&2
        exit 1
        ;;
esac
