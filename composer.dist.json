{
    "name": "dachcom/opendxp-testkit",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        },
        "preferred-install": {
            "open-dxp/opendxp": "source",
            "*": "dist"
        }
    },
    "require": {
        "php": ">=8.3",
        "symfony/runtime": "__SYMFONY_VERSION__",
        "symfony/dotenv": "__SYMFONY_VERSION__",
        "open-dxp/opendxp": "__OPENDXP_VERSION__",
        "__BUNDLE_VENDOR_NAME__": "@dev"
        __ADDITIONAL_PACKAGES__
    },
    __REQUIRE_DEV_DATA__,
    "repositories": [
        {
            "type": "path",
            "url": "./lib/test-bundle",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "OpenDxp\\Model\\DataObject\\": "var/classes/DataObject"
        },
        "classmap": [
            "./src/TestKernel.php"
        ]
    },
    "scripts": {
        "post-create-project-cmd": "OpenDxp\\Composer::postCreateProject",
        "post-install-cmd": [
            "OpenDxp\\Composer::postInstall",
            "@opendxp-scripts"
        ],
        "post-update-cmd": [
            "OpenDxp\\Composer::postUpdate",
            "@opendxp-scripts"
        ],
        "opendxp-scripts": [
            "OpenDxp\\Composer::clearCache",
            "OpenDxp\\Composer::installAssets"
        ]
    },
    "extra": {
    }
}
