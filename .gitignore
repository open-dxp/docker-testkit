# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar

# Logs and databases #
*.log

# Global             #
.DS_*
._*
.idea
.cache/
.config/
ehthumbs.db
Thumbs.db
node_modules
.composer
.bash_history
.viminfo

# Test               #
/data
/app
/assets-test
.ddev/.env
GeoLite2-City.mmdb.gz
GeoLite2-City.mmdb

# AI
/mcp-server/node_modules

# Runtime state      #
.ddev/downloads/
.ddev/slots.tsv

# Analysewerkzeuge   #
# Jedes Werkzeug hat seine eigene composer-Wurzel unter .ddev/tools/.
# composer.json und composer.lock sind versioniert, das vendor nicht.
/.ddev/tools/*/vendor/
